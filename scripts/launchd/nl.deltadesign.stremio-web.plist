<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.deltadesign.stremio-web</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>http.server</string>
        <string>8080</string>
        <string>--bind</string>
        <string>0.0.0.0</string>
    </array>
    <!--
      PAS HET PAD HIERONDER AAN naar waar jij Stremio Web hebt uitgepakt.
      Standaard is dit $HOME/delta-work/stremio-thuis/web/build.
      Launchd doet geen tilde-expansie, dus voluit schrijven.
    -->
    <key>WorkingDirectory</key>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/delta-work/stremio-thuis/web/build</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/stremio-web.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/stremio-web.log</string>
</dict>
</plist>
